{
  "name": "newtonlabs-deck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:pdf:compressed": "node scripts/export-pdf.mjs && node scripts/compress-pdf.mjs",
    "compress:pdf": "node scripts/compress-pdf.mjs",
    "export:pdf:aon": "DECK=aon node scripts/export-pdf.mjs",
    "export:pdf:fund-admins": "DECK=fund-admins node scripts/export-pdf.mjs",
    "export:sheet": "node scripts/export-sheet.mjs",
    "export:pptx": "node scripts/export-pptx.mjs",
    "export:pptx:keynote-pdf": "osascript scripts/keynote-render.applescript && (cd output && pdftoppm -png -r 96 keynote.pdf keynote)",
    "export:pptx:verify": "node scripts/shoot-html.mjs && npm run export:pptx:keynote-pdf && PPTX_SRC=keynote node scripts/compare.mjs"
  },
  "dependencies": {
    "next": "16.1.6",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
